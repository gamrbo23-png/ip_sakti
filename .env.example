# ============================================================
# IP-SAKTI SAHAYAK — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME="IP-SAKTI Sahayak"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ipsakti
POSTGRES_USER=ipsakti_user
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://ipsakti_user:CHANGE_THIS_DATABASE_PASSWORD@localhost:5432/ipsakti
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- LLM Configuration ---
# OpenAI-compatible endpoint. Works with GPT-4o, GPT-5.6 Luna, or any compatible model.
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60

# --- Embedding Model ---
# BAAI/BGE-M3 — runs locally on CPU or GPU
EMBEDDING_MODEL_NAME=BAAI/BGE-M3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=cpu
# Set to "cuda" if GPU is available for faster embedding

# --- Reranker Model ---
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# --- Retrieval Configuration ---
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
RERANK_TOP_K=8
FINAL_CONTEXT_K=5

# --- Confidence Thresholds ---
HIGH_EVIDENCE_THRESHOLD=0.75
MODERATE_EVIDENCE_THRESHOLD=0.45

# --- JWT Authentication ---
JWT_SECRET_KEY=CHANGE_THIS_JWT_SECRET_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# --- Storage ---
STORAGE_BACKEND=local
# Options: local, minio
LOCAL_STORAGE_PATH=./data/raw

# MinIO (optional, for production)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=ipsakti-documents
MINIO_SECURE=false

# --- Document Processing ---
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,txt
OCR_LANGUAGE=eng+hin+ben+tam+tel
OCR_DPI=300

# --- Ingestion ---
INGESTION_CONCURRENCY=4
INGESTION_RETRY_ATTEMPTS=3
INGESTION_RETRY_DELAY_SECONDS=5

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="IP-SAKTI Sahayak"
NEXT_PUBLIC_APP_TAGLINE="Multilingual AI guidance for India's IP & regulatory landscape"

# --- Admin ---
ADMIN_EMAIL=admin@ipsakti.local
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# --- Evaluation ---
EVALUATION_BENCHMARK_PATH=./data/benchmark/questions.json
EVALUATION_OUTPUT_PATH=./data/evaluation_results.json
